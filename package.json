{
  "name": "dxbe",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "description": "A configurable static blog generator with bilingual routing, built-in themes, search, and GitHub Pages deployment.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "dxbe": "./dist/cli.js"
  },
  "exports": {
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "node src/cli/index.ts dev",
    "build": "node src/cli/index.ts build",
    "preview": "node src/cli/index.ts preview",
    "new": "node src/cli/index.ts new",
    "clean": "node src/cli/index.ts clean",
    "setup": "node src/cli/index.ts setup",
    "index": "node src/cli/index.ts index",
    "build:types": "tsup --config tsup.dts.config.ts",
    "build:package": "tsup && npm run build:types && node scripts/copy-package-assets.mjs",
    "prepare": "npm run build:package",
    "build:finish": "npm run check:output && npm run index",
    "build:all": "npm run build && npm run build:finish",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:links": "node src/cli/index.ts check:links",
    "check:seo": "node src/cli/index.ts check:seo",
    "check:output": "npm run check:links && npm run check:seo",
    "check:theme": "node src/cli/index.ts check:theme",
    "check:deterministic": "node src/cli/index.ts check:deterministic",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "check": "npm run verify && node src/cli/index.ts check"
  },
  "dependencies": {
    "@shikijs/rehype": "^4.5.0",
    "chokidar": "^6.0.0",
    "hast-util-to-text": "^4.0.2",
    "katex": "^0.19.1",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.5.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
